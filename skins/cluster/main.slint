import { Car } from "car.slint";
import { Tokens } from "tokens.slint";

export component MainWindow inherits Window {
    width: 1024px;
    height: 600px;
    title: "bean-ui";
    background: Tokens.bg;

    VerticalLayout {
        alignment: center;
        Text {
            text: Car.connected ? "" : "NO CORE";
            color: #E0A030;
            font-size: 48px;
            horizontal-alignment: center;
        }
        Text {
            text: Car.water-known ? "WATER: " + Car.water-c + "°C" : "WATER: --";
            color: Tokens.accent;
            font-size: 48px;
            horizontal-alignment: center;
        }
        Text {
            text: Car.rpm-known ? "RPM: " + Car.rpm : "RPM: ----";
            color: Tokens.accent;
            font-size: 48px;
            horizontal-alignment: center;
        }
    }
}

export { Car } from "car.slint";