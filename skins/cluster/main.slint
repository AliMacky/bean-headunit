import "fonts/Saira_SemiCondensed-Regular.ttf";
import "fonts/Saira_SemiCondensed-SemiBold.ttf";
import "fonts/Saira_SemiCondensed-SemiBoldItalic.ttf";
import "fonts/Saira_SemiCondensed-ExtraBoldItalic.ttf";

import { Car } from "car.slint";
import { Settings } from "settings.slint";
import { Tokens } from "tokens.slint";
import { TopBar } from "top_bar.slint";

export component MainWindow inherits Window {
    default-font-family: "Saira SemiCondensed";
    width: 1024px;
    height: 600px;
    title: "bean-ui";
    background: Tokens.bg;

    VerticalLayout {
        padding-left: Tokens.pad-side;
        padding-right: Tokens.pad-side;
        padding-top: Tokens.pad-top;
        padding-bottom: Tokens.pad-bottom;
        spacing: Tokens.gap-region;


        TopBar { title: Settings.title; status: Car.connected ? "" : "NO CORE"; }

        //content
        Rectangle {
            height: Tokens.content-h;
            border-width: Tokens.border;
            border-color: Tokens.line;
            border-radius: Tokens.radius;

            VerticalLayout {
                alignment: center;
                Text {
                    text: Car.water-known ? "WATER: " + Car.water-c + "°C" : "WATER: --";
                    color: Tokens.text;
                    horizontal-alignment: center;
                    font-size: Tokens.fs-value;
                    font-weight: 800;
                    font-italic: true;
                }
                Text {
                    text: Car.rpm-known ? "RPM: " + Car.rpm : "RPM: ----";
                    color: Tokens.text;
                    font-size: 48px;
                    horizontal-alignment: center;
                }
            }
        }

        //navbar
        Rectangle {
            height: Tokens.nav-h;
            border-width: Tokens.border;
            border-color: Tokens.line;
            border-radius: Tokens.radius;
        }
    }
}

export { Car } from "car.slint";
export { Settings } from "settings.slint";