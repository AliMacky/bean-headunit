import "fonts/Saira_SemiCondensed-Regular.ttf";
import "fonts/Saira_SemiCondensed-SemiBold.ttf";
import "fonts/Saira_SemiCondensed-SemiBoldItalic.ttf";
import "fonts/Saira_SemiCondensed-ExtraBoldItalic.ttf";

import { Car } from "car.slint";
import { Settings } from "settings.slint";
import { Tokens } from "tokens.slint";
import { TopBar } from "top_bar.slint";
import { NavBar } from "nav_bar.slint";
import { Tile, TileState } from "tile.slint";
import { Home } from "home.slint";
import { CarPlayStrip } from "carplay_strip.slint";

export enum TouchKind { down, move, up }

export component MainWindow inherits Window {
    default-font-family: "Saira SemiCondensed";
    preferred-width: 1024px;
    preferred-height: 600px;

    title: "bean-ui";
    background: Tokens.bg;

    in property <image> carplay-frame;
    in property <bool> carplay-connected: false;
    in-out property <bool> carplay-shown: false;
    callback carplay-touch(TouchKind, float, float);

    out property <length> carplay-width: root.width;
    out property <length> carplay-height: root.height - Tokens.carplay-strip-h;

    VerticalLayout {
        padding-left: Tokens.pad-side;
        padding-right: Tokens.pad-side;
        padding-top: Tokens.pad-top;
        padding-bottom: Tokens.pad-bottom;
        spacing: Tokens.gap-region;

        TopBar {
            title: Settings.title;
            status: Car.connected ? "" : "NO CORE";
        }

        Home {
            vertical-stretch: 1;
        }

        //navbar
        NavBar {
            active: 0;
            carplay-available: root.carplay-connected;
            carplay-tapped => {
                root.carplay-shown = true;
            }
        }
    }

    if carplay-connected && carplay-shown: Rectangle {
        background: black;

        CarPlayStrip {
            x: 0;
            y: 0;
            width: parent.width;
            back => {
                root.carplay-shown = false;
            }
        }

        Image {
            x: 0;
            y: Tokens.carplay-strip-h;
            width: root.carplay-width;
            height: root.carplay-height;
            source: carplay-frame;
            image-fit: fill;

            TouchArea {
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                        root.carplay-touch(TouchKind.down, self.mouse-x / self.width, self.mouse-y / self.height);
                    } else if event.kind == PointerEventKind.up && event.button == PointerEventButton.left {
                        root.carplay-touch(TouchKind.up, self.mouse-x / self.width, self.mouse-y / self.height);
                    } else if event.kind == PointerEventKind.cancel {
                        root.carplay-touch(TouchKind.up, self.mouse-x / self.width, self.mouse-y / self.height);
                    }
                }
                moved => {
                    root.carplay-touch(TouchKind.move, self.mouse-x / self.width, self.mouse-y / self.height);
                }
            }
        }

        // iOS draws rounded corners into the video as black pixels. These two
        // caps paint over the top ones in the strip's color, so the strip looks
        // like it wraps around the video. Each is a square minus a quarter circle.
        Path {
            x: 0;
            y: Tokens.carplay-strip-h;
            width: Tokens.carplay-corner;
            height: Tokens.carplay-corner;
            viewbox-width: 1;
            viewbox-height: 1;
            commands: "M 0 0 L 1 0 A 1 1 0 0 0 0 1 Z";
            fill: Tokens.bg;
        }

        Path {
            x: parent.width - Tokens.carplay-corner;
            y: Tokens.carplay-strip-h;
            width: Tokens.carplay-corner;
            height: Tokens.carplay-corner;
            viewbox-width: 1;
            viewbox-height: 1;
            commands: "M 1 0 L 1 1 A 1 1 0 0 0 0 0 Z";
            fill: Tokens.bg;
        }
    }
}

export { Car } from "car.slint";
export { Settings } from "settings.slint";
