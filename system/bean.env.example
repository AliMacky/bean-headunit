# Settings for the head unit. Copy to /etc/bean-headunit/bean.env and edit.
# Lines starting with # are ignored.

# Name in the top bar
BEAN_TITLE=MIATA

# f for °F, c for °C
BEAN_UNITS=f

# Scale the UI for screens that aren't 1024x600 (1.8 fits a 1440p display)
SLINT_SCALE_FACTOR=1

# Line typed under the car on the boot splash
SPLASH_TAGLINE=Mazda MX-5 Miata
